.nh
.TH "GMB" "1" "Sep 2026" "GlassMarble 0.1.0" "GlassMarble Manual"

.SH NAME
gmb-timeline - Show the architecture evolution timeline


.SH SYNOPSIS
\fBgmb timeline [flags]\fP


.SH DESCRIPTION
Renders the chronological story of the architecture, taken from developer memory
(.glassmarble/memory/timeline.json).

.PP
Reasons and event entries are recorded automatically during analysis runs when architectural
changes, refactorings, or ADRs occur.


.SH OPTIONS
\fB--component\fP=""
	Filter entries touching a specific component (case-insensitive substring)

.PP
\fB--format\fP="text"
	Output format: text|json|mermaid

.PP
\fB--from\fP=""
	Window start: ISO date or git ref (default: 6 months ago)

.PP
\fB--full\fP[=false]
	Verbose text output with commit, kind, components, and tags

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for timeline

.PP
\fB--json\fP[=false]
	Emit machine-readable JSON output (alias for --format json)

.PP
\fB--to\fP=""
	Window end: ISO date or git ref (default: now)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	Color output mode: auto|always|never

.PP
\fB-c\fP, \fB--config\fP=""
	Config file path (default is $HOME/.glassmarble.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug logging

.PP
\fB--dir\fP=""
	Target repository directory for analysis and queries

.PP
\fB--max-json-mb\fP=0
	Refuse to load or commit an AKG state file (akg.json) larger than this many MiB (0 = unlimited)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-error output

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose output logging


.SH EXAMPLE
.EX
  # Display full architecture timeline
  gmb timeline

  # Filter timeline by component name
  gmb timeline --component auth

  # Filter by date range or git tag
  gmb timeline --from 2026-01-01 --to HEAD

  # Output timeline as Mermaid diagram or JSON
  gmb timeline --format mermaid
  gmb timeline --json
.EE


.SH SEE ALSO
\fBgmb(1)\fP


