.TH "GMB" "1" "Sep 2026" "GlassMarble 0.1.0" "GlassMarble Manual"

.SH NAME
gmb-update - Check for and install the latest release of GlassMarble


.SH SYNOPSIS
\fBgmb update [flags]\fP


.SH DESCRIPTION
Automatically checks GitHub releases, verifies SHA256 checksums,
and updates the local GlassMarble binary for your operating system and architecture.


.SH OPTIONS
\fB--check\fP[=false]
	Check for newer releases without downloading or installing

.PP
\fB-f\fP, \fB--force\fP[=false]
	Force reinstall even if already running the latest version

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for update

.PP
\fB--json\fP[=false]
	Emit machine-readable JSON output

.PP
\fB-t\fP, \fB--tag\fP=""
	Install a specific release tag (e.g. v1.0.0)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	Color output mode: auto|always|never

.PP
\fB-c\fP, \fB--config\fP=""
	Config file path (default is $HOME/.glassmarble.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug logging

.PP
\fB--dir\fP=""
	Target repository directory for analysis and queries

.PP
\fB--max-json-mb\fP=0
	Refuse to load or commit an AKG state file (akg.json) larger than this many MiB (0 = unlimited)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-error output

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose output logging


.SH EXAMPLE
.EX
  # Update to latest available release
  gmb update

  # Check if a new version is available without installing
  gmb update --check

  # Force reinstall the latest version
  gmb update --force

  # Install a specific release tag
  gmb update --tag v1.0.0

  # Output update status as JSON
  gmb update --check --json
.EE


