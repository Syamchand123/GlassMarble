.TH "GMB" "1" "Sep 2026" "GlassMarble 1.1.0" "GlassMarble Manual"

.SH NAME
gmb-doc-status - Show freshness dashboard for all managed documents


.SH SYNOPSIS
\fBgmb doc status [flags]\fP


.SH DESCRIPTION
Displays a table of all managed documents with their freshness scores,
last sync commit, and render mode.

.PP
Freshness colour coding:
  ✓ green  Document is fully in sync with HEAD
  ⚠ yellow Freshness is below the warn threshold
  ✗ red    Freshness is below the fail threshold (CI would fail)


.SH OPTIONS
\fB--doc\fP=""
	Only check document with this ID

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for status

.PP
\fB--json\fP[=false]
	Emit machine-readable JSON output

.PP
\fB--tag\fP=""
	Only check documents with this tag


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	Color output mode: auto|always|never

.PP
\fB-c\fP, \fB--config\fP=""
	Config file path (default is $HOME/.glassmarble.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug logging

.PP
\fB--dir\fP=""
	Target repository directory for analysis and queries

.PP
\fB--max-json-mb\fP=0
	Refuse to load or commit an AKG state file (akg.json) larger than this many MiB (0 = unlimited)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-error output

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose output logging


.SH EXAMPLE
.EX
  gmb doc status
  gmb doc status --json
.EE


