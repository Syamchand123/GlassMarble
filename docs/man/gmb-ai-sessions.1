.nh
.TH "GMB" "1" "Sep 2026" "GlassMarble 0.1.0" "GlassMarble Manual"

.SH NAME
gmb-ai-sessions - List saved AI chat sessions


.SH SYNOPSIS
\fBgmb ai sessions [flags]\fP


.SH DESCRIPTION
List the conversation sessions saved under .glassmarble/ai/sessions/.
Sessions are written by "gmb ai chat" and can be resumed with
"gmb ai chat --session ".


.SH OPTIONS
\fB--delete\fP=""
	Delete a saved session by id

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for sessions

.PP
\fB--json\fP[=false]
	Emit machine-readable JSON session list


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--base-url\fP=""
	Override the provider API base URL

.PP
\fB--color\fP="auto"
	Color output mode: auto|always|never

.PP
\fB-c\fP, \fB--config\fP=""
	Config file path (default is $HOME/.glassmarble.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug logging

.PP
\fB--dir\fP=""
	Target repository directory for analysis and queries

.PP
\fB--key\fP=""
	API key for the AI provider (prefer env vars or gmb ai configure)

.PP
\fB--max-cost\fP=0
	Stop a run when estimated spend exceeds this USD amount (0 = unlimited)

.PP
\fB--max-json-mb\fP=0
	Refuse to load or commit an AKG state file (akg.json) larger than this many MiB (0 = unlimited)

.PP
\fB--max-session-messages\fP=0
	Chat history budget: keep at most this many session messages

.PP
\fB--max-total-tokens\fP=0
	Stop a run when summed prompt+completion tokens exceed this (0 = unlimited)

.PP
\fB--max-turns\fP=0
	Maximum agent tool-call turns

.PP
\fB--model\fP=""
	AI model identifier

.PP
\fB--no-stream\fP[=false]
	Disable token streaming (buffered output)

.PP
\fB--no-tools\fP[=false]
	Plain chat mode without tool calling

.PP
\fB--provider\fP=""
	AI provider name (openai, anthropic, gemini, deepseek, ...)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-error output

.PP
\fB--save\fP=""
	Save the final answer to .glassmarble/ai/ (diagram markup to .glassmarble/marbles/) instead of printing it (single-query mode)

.PP
\fB--temperature\fP=0
	Sampling temperature (0 = provider default)

.PP
\fB--timeout\fP=0
	HTTP timeout in seconds

.PP
\fB--tools\fP=""
	Restrict agent tools to categories (system, akg, code, diagram) or names, comma-separated

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose output logging


.SH EXAMPLE
.EX
  # List all saved AI chat sessions
  gmb ai sessions

  # Delete a specific saved session
  gmb ai sessions --delete 2026-08-24-10-00-00

  # Output session history list as JSON
  gmb ai sessions --json
.EE


