.TH "GMB" "1" "Sep 2026" "GlassMarble 0.1.0" "GlassMarble Manual"

.SH NAME
gmb-stats - Display pipeline execution telemetry and performance stats


.SH SYNOPSIS
\fBgmb stats [flags]\fP


.SH DESCRIPTION
Surfaces pipeline phase timings (parse, translate, normalize, aggregate,
link, akg-commit, extract, project, render) and architectural coupling health metrics.


.SH OPTIONS
\fB--arch\fP[=false]
	Display component coupling (Ca/Ce/Instability) from architecture intelligence

.PP
\fB--bench\fP[=false]
	Display pipeline benchmark gates and budget status

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for stats

.PP
\fB--json\fP[=false]
	Emit machine-readable JSON output


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	Color output mode: auto|always|never

.PP
\fB-c\fP, \fB--config\fP=""
	Config file path (default is $HOME/.glassmarble.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug logging

.PP
\fB--dir\fP=""
	Target repository directory for analysis and queries

.PP
\fB--max-json-mb\fP=0
	Refuse to load or commit an AKG state file (akg.json) larger than this many MiB (0 = unlimited)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-error output

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose output logging


.SH EXAMPLE
.EX
  # Display telemetry spans from last pipeline execution
  gmb stats

  # Display component coupling and architectural stability metrics
  gmb stats --arch

  # View benchmark reference thresholds
  gmb stats --bench

  # Output statistics as JSON
  gmb stats --arch --json
.EE


.SH SEE ALSO
\fBgmb(1)\fP


