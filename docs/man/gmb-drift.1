.TH "GMB" "1" "Sep 2026" "GlassMarble 0.1.0" "GlassMarble Manual"

.SH NAME
gmb-drift - Detect architecture drift against declared layering and cycle budgets


.SH SYNOPSIS
\fBgmb drift [flags]\fP


.SH DESCRIPTION
Compares the committed AKG against the invariants declared in
\&.glassmarble/config.yaml under the "drift" key.

.PP
Reports forbidden cross-layer dependencies and layer cycles, and exits non-zero
when declared cycle budgets or forbidden dependencies are breached (suitable for CI gates).


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for drift

.PP
\fB--json\fP[=false]
	Emit machine-readable JSON output


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	Color output mode: auto|always|never

.PP
\fB-c\fP, \fB--config\fP=""
	Config file path (default is $HOME/.glassmarble.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug logging

.PP
\fB--dir\fP=""
	Target repository directory for analysis and queries

.PP
\fB--max-json-mb\fP=0
	Refuse to load or commit an AKG state file (akg.json) larger than this many MiB (0 = unlimited)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-error output

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose output logging


.SH EXAMPLE
.EX
  # Check current architecture for layer drift and cycles
  gmb drift

  # Output drift report as JSON for CI gating
  gmb drift --json

  # Run drift checks on a specific directory
  gmb drift --dir ./backend
.EE


.SH SEE ALSO
\fBgmb(1)\fP


