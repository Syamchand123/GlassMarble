.nh
.TH "GMB" "1" "Sep 2026" "GlassMarble 0.1.0" "GlassMarble Manual"

.SH NAME
gmb-inspect - Inspect AKG graph nodes, search symbols, and discover entry points


.SH SYNOPSIS
\fBgmb inspect [node_id] [flags]\fP


.SH DESCRIPTION
Queries the active Architecture Knowledge Graph to search nodes, discover entry points, or view detailed symbol metadata and inbound/outbound dependency edges.


.SH OPTIONS
\fB--file\fP=""
	File path to look up (requires --line)

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for inspect

.PP
\fB--json\fP[=false]
	Emit machine-readable JSON output

.PP
\fB--languages\fP[=false]
	Display the 14-Language support matrix report

.PP
\fB--line\fP=0
	Line number to look up (requires --file)

.PP
\fB--list\fP[=false]
	List candidate entry points for sequence diagrams

.PP
\fB--search\fP=""
	Search nodes by symbol name or path fragment

.PP
\fB--type\fP=""
	Filter by node kind (FUNCTION, METHOD, STRUCT, CLASS, INTERFACE)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	Color output mode: auto|always|never

.PP
\fB-c\fP, \fB--config\fP=""
	Config file path (default is $HOME/.glassmarble.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug logging

.PP
\fB--dir\fP=""
	Target repository directory for analysis and queries

.PP
\fB--max-json-mb\fP=0
	Refuse to load or commit an AKG state file (akg.json) larger than this many MiB (0 = unlimited)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-error output

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose output logging


.SH EXAMPLE
.EX
  # Search for a symbol or class
  gmb inspect --search UserService

  # List candidate entry points (functions and methods)
  gmb inspect --list --type FUNCTION

  # View details and edges for a specific symbol ID
  gmb inspect "cmd/root.go::Execute"

  # Find symbol at a specific file and line number
  gmb inspect --file internal/app/app.go --line 42

  # Output symbol details as JSON
  gmb inspect --search Database --json
.EE


.SH SEE ALSO
\fBgmb(1)\fP


