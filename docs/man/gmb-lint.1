.TH "GMB" "1" "Sep 2026" "GlassMarble 0.1.0" "GlassMarble Manual"

.SH NAME
gmb-lint - Lint repository against architectural rules and layer boundaries


.SH SYNOPSIS
\fBgmb lint [flags]\fP


.SH DESCRIPTION
Evaluates the Architecture Knowledge Graph against custom declarative rules
(e.g., .glassmarble/rules.yaml) to catch illegal layer imports, forbidden dependencies,
and cyclic coupling. Returns exit code 1 if violations are found.


.SH OPTIONS
\fB--fail-on-warn\fP[=false]
	Exit with non-zero status on warnings

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for lint

.PP
\fB--init\fP[=false]
	Scaffold a starter .glassmarble/rules.yaml file

.PP
\fB--json\fP[=false]
	Emit machine-readable JSON output

.PP
\fB-r\fP, \fB--rules\fP=""
	Path to architecture rules YAML file

.PP
\fB--strict\fP[=false]
	Treat warnings as errors (fail on any violation)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	Color output mode: auto|always|never

.PP
\fB-c\fP, \fB--config\fP=""
	Config file path (default is $HOME/.glassmarble.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug logging

.PP
\fB--dir\fP=""
	Target repository directory for analysis and queries

.PP
\fB--max-json-mb\fP=0
	Refuse to load or commit an AKG state file (akg.json) larger than this many MiB (0 = unlimited)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-error output

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose output logging


.SH EXAMPLE
.EX
  # Run architecture linter with default .glassmarble/rules.yaml
  gmb lint

  # Scaffold a starter rules.yaml file
  gmb lint --init

  # Lint with custom rules file and strict mode
  gmb lint --rules my-rules.yaml --strict

  # Output lint results as JSON for CI/CD pipelines
  gmb lint --json
.EE


