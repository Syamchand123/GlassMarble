.TH "GMB" "1" "Sep 2026" "GlassMarble 1.2.0" "GlassMarble Manual"

.SH NAME
gmb-doc-diff - Preview what the engine would change without writing files


.SH SYNOPSIS
\fBgmb doc diff [target.md] [flags]\fP


.SH DESCRIPTION
Computes what sections would be updated and shows the pending diff
without touching any files on disk.

.PP
Exit codes:
  0  No changes pending
  1  Changes would be made


.SH OPTIONS
\fB--doc\fP=""
	Only diff the document with this ID

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for diff

.PP
\fB--json\fP[=false]
	Emit machine-readable JSON output

.PP
\fB--tag\fP=""
	Only diff documents with this tag


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	Color output mode: auto|always|never

.PP
\fB-c\fP, \fB--config\fP=""
	Config file path (default is $HOME/.glassmarble.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug logging

.PP
\fB--dir\fP=""
	Target repository directory for analysis and queries

.PP
\fB--max-json-mb\fP=0
	Refuse to load or commit an AKG state file (akg.json) larger than this many MiB (0 = unlimited)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-error output

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose output logging


.SH EXAMPLE
.EX
  gmb doc diff docs/auth.md
  gmb doc diff --doc auth
.EE


.SH SEE ALSO
\fBgmb-doc(1)\fP


