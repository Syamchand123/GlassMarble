.nh
.TH "GMB" "1" "Sep 2026" "GlassMarble 0.1.0" "GlassMarble Manual"

.SH NAME
gmb-impact - Simulate refactoring blast-radius and transitive dependency impact


.SH SYNOPSIS
\fBgmb impact [symbol or file] [flags]\fP


.SH DESCRIPTION
Performs topological reverse reachability analysis across the Architecture
Knowledge Graph to compute direct and transitive callers, impacted entrypoints,
and exposed test suites before refactoring or deleting a symbol.


.SH OPTIONS
\fB-d\fP, \fB--depth\fP=0
	Maximum reverse dependency traversal depth (0 = unlimited)

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for impact

.PP
\fB--json\fP[=false]
	Emit machine-readable JSON output

.PP
\fB--tests-only\fP[=false]
	Print only the list of impacted test files

.PP
\fB--threshold\fP=0
	Fail with non-zero exit code if risk score exceeds threshold

.PP
\fB--visualize\fP[=false]
	Render Mermaid blast-radius flowchart


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	Color output mode: auto|always|never

.PP
\fB-c\fP, \fB--config\fP=""
	Config file path (default is $HOME/.glassmarble.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug logging

.PP
\fB--dir\fP=""
	Target repository directory for analysis and queries

.PP
\fB--max-json-mb\fP=0
	Refuse to load or commit an AKG state file (akg.json) larger than this many MiB (0 = unlimited)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-error output

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose output logging


.SH EXAMPLE
.EX
  # Analyze blast radius of modifying a struct or function
  gmb impact UserStore

  # View blast radius of changing a file with depth limit
  gmb impact internal/auth/auth.go --depth 3

  # Output only the test suites that must be re-run
  gmb impact ProcessPayment --tests-only

  # Render a visual Mermaid blast-radius flowchart
  gmb impact DatabaseDriver --visualize

  # Check in CI if refactoring risk exceeds threshold (fails if risk > 50)
  gmb impact LegacyEngine --threshold 50
.EE


.SH SEE ALSO
\fBgmb(1)\fP


