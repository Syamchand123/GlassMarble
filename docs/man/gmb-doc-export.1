.nh
.TH "GMB" "1" "Sep 2026" "GlassMarble 1.1.0" "GlassMarble Manual"

.SH NAME
gmb-doc-export - Export managed docs as a RAG-ready chunked knowledge base


.SH SYNOPSIS
\fBgmb doc export [flags]\fP


.SH DESCRIPTION
Generates pre-chunked, AKG-tagged knowledge chunks under .glassmarble/rag/.

.PP
Each chunk is tagged with exact AST symbol IDs, file paths, and line numbers.
Compatible with LlamaIndex, LangChain, and direct embedding APIs.

.PP
Formats:
  rag     Section-level chunks with full AKG metadata (default)
  jsonl   One JSON object per chunk in JSONL format
  state   Raw docs_state.json dump (engine state, for interchange tooling)


.SH OPTIONS
\fB--format\fP="rag"
	Export format: rag|jsonl|state

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for export

.PP
\fB--json\fP[=false]
	Emit machine-readable JSON output

.PP
\fB--out\fP=".glassmarble/rag"
	Output directory


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	Color output mode: auto|always|never

.PP
\fB-c\fP, \fB--config\fP=""
	Config file path (default is $HOME/.glassmarble.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug logging

.PP
\fB--dir\fP=""
	Target repository directory for analysis and queries

.PP
\fB--max-json-mb\fP=0
	Refuse to load or commit an AKG state file (akg.json) larger than this many MiB (0 = unlimited)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-error output

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose output logging


.SH EXAMPLE
.EX
  gmb doc export --format rag
  gmb doc export --format jsonl --out .glassmarble/rag/
  gmb doc export --format state
  gmb doc export --format state --out .glassmarble/state.json
.EE


.SH SEE ALSO
\fBgmb-doc(1)\fP


