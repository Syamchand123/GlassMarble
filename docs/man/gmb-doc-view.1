.TH "GMB" "1" "Sep 2026" "GlassMarble 1.1.0" "GlassMarble Manual"

.SH NAME
gmb-doc-view - Open a managed document in the terminal TUI reader


.SH SYNOPSIS
\fBgmb doc view [target.md] [flags]\fP


.SH DESCRIPTION
Opens the specified document in an interactive terminal reader powered
by Bubble Tea. Supports fuzzy section search and symbol-to-source navigation
(Enter on a symbol link opens $EDITOR at the exact file:line).


.SH OPTIONS
\fB--doc\fP=""
	Document ID to open

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for view


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	Color output mode: auto|always|never

.PP
\fB-c\fP, \fB--config\fP=""
	Config file path (default is $HOME/.glassmarble.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug logging

.PP
\fB--dir\fP=""
	Target repository directory for analysis and queries

.PP
\fB--max-json-mb\fP=0
	Refuse to load or commit an AKG state file (akg.json) larger than this many MiB (0 = unlimited)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-error output

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose output logging


.SH EXAMPLE
.EX
  gmb doc view docs/auth.md
  gmb doc view --doc auth
.EE


.SH SEE ALSO
\fBgmb-doc(1)\fP


