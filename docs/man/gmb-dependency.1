.TH "GMB" "1" "Sep 2026" "GlassMarble 0.1.0" "GlassMarble Manual"

.SH NAME
gmb-dependency - Analyze inbound and outbound dependencies for a file or symbol


.SH SYNOPSIS
\fBgmb dependency [target_file_or_symbol] [flags]\fP


.SH DESCRIPTION
Inspects direct call, import, and composition dependencies for a target file or symbol in the Architecture Knowledge Graph.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for dependency

.PP
\fB--json\fP[=false]
	Emit machine-readable JSON output


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	Color output mode: auto|always|never

.PP
\fB-c\fP, \fB--config\fP=""
	Config file path (default is $HOME/.glassmarble.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug logging

.PP
\fB--dir\fP=""
	Target repository directory for analysis and queries

.PP
\fB--max-json-mb\fP=0
	Refuse to load or commit an AKG state file (akg.json) larger than this many MiB (0 = unlimited)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-error output

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose output logging


.SH EXAMPLE
.EX
  # View global dependency summary and top outbound nodes
  gmb dependency

  # Inspect inbound and outbound edges for a specific symbol
  gmb dependency "cmd/root.go::Execute"

  # Inspect dependencies for an entire file
  gmb dependency internal/app/app.go

  # Output dependency edges as JSON
  gmb dependency --json
.EE


.SH SEE ALSO
\fBgmb(1)\fP


