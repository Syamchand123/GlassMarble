.TH "GMB" "1" "Sep 2026" "GlassMarble 0.1.0" "GlassMarble Manual"

.SH NAME
gmb-ui - Launch local interactive architecture visualizer web server


.SH SYNOPSIS
\fBgmb ui [flags]\fP


.SH DESCRIPTION
Starts a lightweight, zero-dependency local web server serving an interactive
2D/3D force-directed architecture graph with real-time node inspection, search,
and blast-radius simulation.

.PP
With --json the bound address and graph size are written to stdout as a single
JSON document as soon as the listener is up; the server then keeps running, so
a supervising script can read the document, learn the URL, and leave the
process serving.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for ui

.PP
\fB--host\fP="127.0.0.1"
	Host address to bind to

.PP
\fB--json\fP[=false]
	Emit a machine-readable JSON startup document, then keep serving

.PP
\fB--no-open\fP[=false]
	Do not open web browser automatically

.PP
\fB-o\fP, \fB--open\fP[=true]
	Automatically open default web browser

.PP
\fB-p\fP, \fB--port\fP=8080
	Port to listen on


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	Color output mode: auto|always|never

.PP
\fB-c\fP, \fB--config\fP=""
	Config file path (default is $HOME/.glassmarble.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug logging

.PP
\fB--dir\fP=""
	Target repository directory for analysis and queries

.PP
\fB--max-json-mb\fP=0
	Refuse to load or commit an AKG state file (akg.json) larger than this many MiB (0 = unlimited)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-error output

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose output logging


.SH EXAMPLE
.EX
  # Launch interactive visualizer and open default browser
  gmb ui

  # Serve on custom port without automatically opening browser
  gmb ui --port 3000 --no-open

  # Equivalent alias
  gmb serve -p 8080

  # Discover the bound URL from a script (auto-assigned port)
  gmb ui --port 0 --no-open --json
.EE


