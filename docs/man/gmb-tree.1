.TH "GMB" "1" "Sep 2026" "GlassMarble 0.1.0" "GlassMarble Manual"

.SH NAME
gmb-tree - Display architectural directory and symbol hierarchy tree


.SH SYNOPSIS
\fBgmb tree [flags]\fP


.SH DESCRIPTION
Renders a tree representation of indexed packages, classes, and methods up to the specified directory segment depth.


.SH OPTIONS
\fB--depth\fP=4
	Maximum directory segment depth

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for tree

.PP
\fB--json\fP[=false]
	Emit machine-readable JSON output


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	Color output mode: auto|always|never

.PP
\fB-c\fP, \fB--config\fP=""
	Config file path (default is $HOME/.glassmarble.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug logging

.PP
\fB--dir\fP=""
	Target repository directory for analysis and queries

.PP
\fB--max-json-mb\fP=0
	Refuse to load or commit an AKG state file (akg.json) larger than this many MiB (0 = unlimited)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-error output

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose output logging


.SH EXAMPLE
.EX
  # Render workspace symbol hierarchy tree (default depth 4)
  gmb tree

  # Limit tree traversal to 2 directory segments
  gmb tree --depth 2

  # Output full symbol tree as JSON
  gmb tree --json
.EE


