.TH "GMB" "1" "Sep 2026" "GlassMarble 0.1.0" "GlassMarble Manual"

.SH NAME
gmb-export - Export the AKG snapshot to GraphJSON or Neo4j Cypher format


.SH SYNOPSIS
\fBgmb export [flags]\fP


.SH DESCRIPTION
Writes the active AKG snapshot to a machine-readable, diff-friendly file.

.PP
GraphJSON is the canonical interchange format. Neo4j Cypher mode generates
executable CREATE scripts for direct import into Neo4j graph database instances.


.SH OPTIONS
\fB-f\fP, \fB--format\fP="graphjson"
	Export format: graphjson (default) or neo4j

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for export

.PP
\fB--json\fP[=false]
	Emit machine-readable JSON receipt

.PP
\fB-o\fP, \fB--output\fP=""
	Output file path (graph.json or dump.cypher)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	Color output mode: auto|always|never

.PP
\fB-c\fP, \fB--config\fP=""
	Config file path (default is $HOME/.glassmarble.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug logging

.PP
\fB--dir\fP=""
	Target repository directory for analysis and queries

.PP
\fB--max-json-mb\fP=0
	Refuse to load or commit an AKG state file (akg.json) larger than this many MiB (0 = unlimited)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-error output

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose output logging


.SH EXAMPLE
.EX
  # Export AKG snapshot as canonical GraphJSON
  gmb export --output graph.json

  # Export AKG snapshot as Neo4j Cypher import script
  gmb export --format neo4j --output dump.cypher

  # Export and emit JSON receipt
  gmb export --output graph.json --json
.EE


