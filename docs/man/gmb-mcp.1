.TH "GMB" "1" "Sep 2026" "GlassMarble 0.1.0" "GlassMarble Manual"

.SH NAME
gmb-mcp - Start Model Context Protocol (MCP) server for Claude Desktop, Cursor, Zed, Continue


.SH SYNOPSIS
\fBgmb mcp [flags]\fP


.SH DESCRIPTION
Starts the GlassMarble Model Context Protocol (MCP) server.
Allows AI clients (Claude Desktop, Cursor, Windsurf, Zed, Continue.dev) to query the Architecture Knowledge Graph,
evaluate blast-radius risk, render architecture diagrams, search developer memory, and inspect point-in-time snapshots.


.SH OPTIONS
\fB--auth-token\fP=""
	Bearer token for HTTP/SSE transport (or GLASSMARBLE_MCP_TOKEN)

.PP
\fB--config-client\fP=""
	Generate ready-to-paste client configuration (claude, cursor, zed, continue, all)

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for mcp

.PP
\fB--host\fP="127.0.0.1"
	Bind address for http/sse transport (loopback by default)

.PP
\fB--json\fP[=false]
	Emit output as JSON

.PP
\fB--max-json-mb\fP=256
	Maximum AKG JSON payload size budget in megabytes

.PP
\fB--port\fP=8765
	Port for http/sse transport

.PP
\fB--print-config\fP[=false]
	Print ready-to-paste client configuration JSON snippets

.PP
\fB--tool-timeout\fP=0
	Per-tool execution timeout in seconds (0 = default 60, negative = unbounded)

.PP
\fB--tools\fP=""
	Comma-separated tool filter: categories (system,akg,code,diagram) or exact tool names, e.g. --tools akg,impact

.PP
\fB--transport\fP="stdio"
	MCP transport protocol: stdio (default), http (Streamable HTTP), or sse (legacy)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	Color output mode: auto|always|never

.PP
\fB-c\fP, \fB--config\fP=""
	Config file path (default is $HOME/.glassmarble.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug logging

.PP
\fB--dir\fP=""
	Target repository directory for analysis and queries

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-error output

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose output logging


.SH EXAMPLE
.EX
  # Start MCP server over standard input/output (Claude Desktop, Cursor)
  gmb mcp

  # Start MCP server over HTTP/SSE on port 8088
  gmb mcp --transport sse --port 8088

  # Print ready-to-paste client configuration JSON for Claude Desktop
  gmb mcp --config-client claude

  # Print client configuration for Cursor / Windsurf
  gmb mcp --config-client cursor

  # Print all client configuration snippets
  gmb mcp --config-client all
.EE


.SH SEE ALSO
\fBgmb(1)\fP


