.TH "GMB" "1" "Sep 2026" "GlassMarble 0.1.0" "GlassMarble Manual"

.SH NAME
gmb-status - Display AKG database status, node statistics, and graph health


.SH SYNOPSIS
\fBgmb status [flags]\fP


.SH DESCRIPTION
Inspects the active .glassmarble database and prints graph metrics,
schema version, commit hash, analysis freshness, and overall graph health.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for status

.PP
\fB--json\fP[=false]
	Emit machine-readable JSON output


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	Color output mode: auto|always|never

.PP
\fB-c\fP, \fB--config\fP=""
	Config file path (default is $HOME/.glassmarble.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug logging

.PP
\fB--dir\fP=""
	Target repository directory for analysis and queries

.PP
\fB--max-json-mb\fP=0
	Refuse to load or commit an AKG state file (akg.json) larger than this many MiB (0 = unlimited)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-error output

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose output logging


.SH EXAMPLE
.EX
  # View current graph status
  gmb status

  # Output status as JSON for scripting
  gmb status --json

  # Inspect a specific repository directory
  gmb status --dir ./backend
.EE


.SH SEE ALSO
\fBgmb(1)\fP


