.TH "GMB" "1" "Aug 2026" "GlassMarble 0.1.0" "GlassMarble Manual"

.SH NAME
gmb-diff - Show the persisted AKG state and its committed transaction version


.SH SYNOPSIS
\fBgmb diff [flags]\fP


.SH DESCRIPTION
Reports the currently persisted architectural state: commit hash, schema
version, and the graph version (the sequence of committed transactions captured
in akg.json).


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for diff

.PP
\fB--json\fP[=false]
	Emit machine-readable JSON output


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	Color output mode: auto|always|never

.PP
\fB-c\fP, \fB--config\fP=""
	Config file path (default is $HOME/.glassmarble.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug logging

.PP
\fB--dir\fP=""
	Target repository directory for analysis and queries

.PP
\fB--max-json-mb\fP=0
	Refuse to load or commit an AKG state file (akg.json) larger than this many MiB (0 = unlimited)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-error output

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose output logging


.SH EXAMPLE
.EX
  # Display current graph version and commit state
  gmb diff

  # Output state version as JSON
  gmb diff --json

  # Inspect diff metadata for a specific directory
  gmb diff --dir ./backend
.EE


