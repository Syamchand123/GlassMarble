.TH "GMB" "1" "Aug 2026" "GlassMarble 0.1.0" "GlassMarble Manual"

.SH NAME
gmb-ai - Ask GlassMarble AI Architect anything about your codebase


.SH SYNOPSIS
\fBgmb ai [question] [flags]\fP


.SH DESCRIPTION
Ask the GlassMarble AI Architect a question about your repository.

.PP
The AI engine is Bring-Your-Own-Key (BYOK): configure your provider and model
with "gmb ai configure", or via GLASSMARBLE\fIAI\fP* environment variables.

.PP
The agent answers by calling repository tools: AKG knowledge-graph queries
(akg\fI*), source readers (code\fP\fI), diagram generation (diagram_\fP), and system
status (system_*).


.SH OPTIONS
\fB--base-url\fP=""
	Override the provider API base URL

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for ai

.PP
\fB--key\fP=""
	API key for the AI provider (prefer env vars or gmb ai configure)

.PP
\fB--max-cost\fP=0
	Stop a run when estimated spend exceeds this USD amount (0 = unlimited)

.PP
\fB--max-session-messages\fP=0
	Chat history budget: keep at most this many session messages

.PP
\fB--max-total-tokens\fP=0
	Stop a run when summed prompt+completion tokens exceed this (0 = unlimited)

.PP
\fB--max-turns\fP=0
	Maximum agent tool-call turns

.PP
\fB--model\fP=""
	AI model identifier

.PP
\fB--no-stream\fP[=false]
	Disable token streaming (buffered output)

.PP
\fB--no-tools\fP[=false]
	Plain chat mode without tool calling

.PP
\fB--provider\fP=""
	AI provider name (openai, anthropic, gemini, deepseek, ...)

.PP
\fB--save\fP=""
	Save the final answer to .glassmarble/ai/ (diagram markup to .glassmarble/marbles/) instead of printing it (single-query mode)

.PP
\fB--temperature\fP=0
	Sampling temperature (0 = provider default)

.PP
\fB--timeout\fP=0
	HTTP timeout in seconds

.PP
\fB--tools\fP=""
	Restrict agent tools to categories (system, akg, code, diagram) or names, comma-separated


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	Color output mode: auto|always|never

.PP
\fB-c\fP, \fB--config\fP=""
	Config file path (default is $HOME/.glassmarble.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug logging

.PP
\fB--dir\fP=""
	Target repository directory for analysis and queries

.PP
\fB--max-json-mb\fP=0
	Refuse to load or commit an AKG state file (akg.json) larger than this many MiB (0 = unlimited)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-error output

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose output logging


.SH EXAMPLE
.EX
  # Ask a question about the repository architecture
  gmb ai "explain the architecture of this repository"

  # Ask a dependency question
  gmb ai "which services depend on the payment module"

  # Ask AI to generate a C4 container diagram and save it
  gmb ai "generate a C4 container diagram" --save c4.md

  # Restrict tool usage to code and AKG tools only
  gmb ai --tools akg,code "where is user authentication implemented?"

  # Start an interactive chat session
  gmb ai chat

  # Diagnose AI engine setup and connectivity
  gmb ai doctor
.EE


