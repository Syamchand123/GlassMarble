.nh
.TH "GMB" "1" "Aug 2026" "GlassMarble 0.1.0" "GlassMarble Manual"

.SH NAME
gmb-analyze - Run full source code ingestion and build Architecture Knowledge Graph (AKG)


.SH SYNOPSIS
\fBgmb analyze [flags]\fP


.SH DESCRIPTION
Executes incremental or full ingestion, AST parsing, normalization, topology
aggregation, CPG linking, and commits the graph state to .glassmarble/akg.json.

.PP
See also: 'gmb status', 'gmb watch', 'gmb doctor'


.SH OPTIONS
\fB--abort-on-limit\fP[=false]
	Abort analysis if --max-nodes is exceeded (otherwise warn)

.PP
\fB--bench\fP[=false]
	Run analysis benchmark battery and verify performance against budget gates

.PP
\fB--commit\fP=""
	Git commit hash to tag the analysis (empty diffs working tree against HEAD)

.PP
\fB--full\fP[=false]
	Force a full clean scan of every file at full linker detail (default: incremental delta)

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for analyze

.PP
\fB--include-docs\fP[=false]
	Run knowledge fusion: fuse ADR/README/PR claims into developer memory

.PP
\fB--intelligence\fP[=true]
	Run architectural intelligence checks (smells and pattern discovery)

.PP
\fB--json\fP[=false]
	Emit machine-readable JSON output

.PP
\fB--link-level\fP="architecture"
	Linker detail level: architecture (module/type/call/dep edges), standard (aggregate CFG), full (per-branch CFG+DFG)

.PP
\fB--macro-inference\fP="all"
	Macro inference mode: disabled, structural (only rules with evidence), all (full heuristic+structural)

.PP
\fB--max-nodes\fP=0
	Max total CPG nodes before warning/abort (0 = unlimited)

.PP
\fB--no-intelligence\fP[=false]
	Disable architectural intelligence checks (equivalent to --intelligence=false)

.PP
\fB--store-code\fP[=false]
	Store source code content snippets in AKG nodes (default: false)

.PP
\fB--workers\fP=0
	Number of parallel workers (default: available CPUs)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	Color output mode: auto|always|never

.PP
\fB-c\fP, \fB--config\fP=""
	Config file path (default is $HOME/.glassmarble.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug logging

.PP
\fB--dir\fP=""
	Target repository directory for analysis and queries

.PP
\fB--max-json-mb\fP=0
	Refuse to load or commit an AKG state file (akg.json) larger than this many MiB (0 = unlimited)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-error output

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose output logging


.SH EXAMPLE
.EX
  # Run standard incremental analysis on current directory
  gmb analyze

  # Force a clean full analysis scan
  gmb analyze --full

  # Disable AI intelligence smells/pattern detection
  gmb analyze --no-intelligence

  # Run analysis and emit JSON payload
  gmb analyze --json

  # Run performance benchmark gates
  gmb analyze --bench
.EE


