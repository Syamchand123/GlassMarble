.TH "GMB" "1" "Aug 2026" "GlassMarble 0.1.0" "GlassMarble Manual"

.SH NAME
gmb-hotspot - Identify high-coupling architectural hotspots and most-depended-upon symbols


.SH SYNOPSIS
\fBgmb hotspot [flags]\fP


.SH DESCRIPTION
Ranks nodes by in-degree call density and centrality to highlight architectural hotspots and high-risk refactoring targets.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for hotspot

.PP
\fB--json\fP[=false]
	Emit machine-readable JSON output

.PP
\fB--top\fP=10
	Number of top hotspot symbols to display (1-100)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	Color output mode: auto|always|never

.PP
\fB-c\fP, \fB--config\fP=""
	Config file path (default is $HOME/.glassmarble.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug logging

.PP
\fB--dir\fP=""
	Target repository directory for analysis and queries

.PP
\fB--max-json-mb\fP=0
	Refuse to load or commit an AKG state file (akg.json) larger than this many MiB (0 = unlimited)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-error output

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose output logging


.SH EXAMPLE
.EX
  # Display top 10 architectural hotspots
  gmb hotspot

  # Display top 25 hotspots
  gmb hotspot --top 25

  # Output hotspot rankings as JSON
  gmb hotspot --json
.EE


