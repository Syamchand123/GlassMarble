.TH "GMB" "1" "Aug 2026" "GlassMarble 0.1.0" "GlassMarble Manual"

.SH NAME
gmb-visualize - Generate visual architecture diagrams (marbles) from the AKG


.SH SYNOPSIS
\fBgmb visualize [diagram_type] [flags]\fP


.SH DESCRIPTION
Queries the canonical AKG state database (akg.json) and projects the graph layout
into Mermaid.js, PlantUML, or DOT markup format.

.PP
Run 'gmb visualize list' to view all 31 supported diagram types.


.SH OPTIONS
\fB--changed-files\fP=[]
	Comma-separated list of changed files for impact analysis

.PP
\fB--community\fP[=false]
	Enable community detection

.PP
\fB--depth\fP=7
	Maximum search depth limit for reachability path walk

.PP
\fB--direction\fP="auto"
	Layout direction: auto, TB, LR, or TD

.PP
\fB--entry\fP=""
	Execution entry point symbol ID (mandatory for sequence diagrams)

.PP
\fB--format\fP="mermaid"
	Output format: mermaid, plantuml, dot, or html

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for visualize

.PP
\fB--include-tests\fP[=false]
	Include test files (*_test.go) and test functions in diagram

.PP
\fB--json\fP[=false]
	Emit machine-readable JSON output containing diagram markup and summary

.PP
\fB--link-level\fP="architecture"
	Detail level of graph linkage: architecture, standard, or full

.PP
\fB--max-nodes\fP=0
	Maximum number of nodes to include in diagram (0 = unlimited)

.PP
\fB--output\fP=""
	Write diagram to file instead of stdout

.PP
\fB--pagerank\fP[=false]
	Enable PageRank computation

.PP
\fB--relative\fP[=false]
	Render file/symbol paths relative to folder root under folder scope

.PP
\fB--render\fP=""
	Render diagram to image file (.svg or .png) via Kroki or mermaid-cli

.PP
\fB--save\fP=""
	Save the diagram to a markdown file inside .glassmarble/marbles/

.PP
\fB--scc\fP[=false]
	Enable strongly connected components analysis

.PP
\fB--scope\fP=""
	Filter layout to specific scope: global (default), folder:path, or file:path

.PP
\fB--summary\fP[=false]
	Print graph summary before the diagram

.PP
\fB--theme\fP="modern"
	Color palette theme: modern, dark, nordic, forest, or mono

.PP
\fB--unused\fP[=false]
	Include unreferenced dead components in the layout


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	Color output mode: auto|always|never

.PP
\fB-c\fP, \fB--config\fP=""
	Config file path (default is $HOME/.glassmarble.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug logging

.PP
\fB--dir\fP=""
	Target repository directory for analysis and queries

.PP
\fB--max-json-mb\fP=0
	Refuse to load or commit an AKG state file (akg.json) larger than this many MiB (0 = unlimited)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-error output

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose output logging


.SH EXAMPLE
.EX
  # Generate class diagram in Mermaid format
  gmb visualize class

  # Generate sequence diagram with an entry point symbol
  gmb visualize sequence --entry "cmd/root.go::Execute"

  # Generate C4 container diagram in PlantUML format
  gmb visualize c4container --format plantuml

  # Scope diagram to a specific package directory
  gmb visualize class --scope folder:internal/app

  # List all 31 supported diagram types
  gmb visualize list

  # Output diagram markup and graph summary as JSON
  gmb visualize dependency --json
.EE


.SH SEE ALSO
\fBgmb(1)\fP


