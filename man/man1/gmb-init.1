.TH "GMB" "1" "Aug 2026" "GlassMarble 0.1.0" "GlassMarble Manual"

.SH NAME
gmb-init - Initialize a repository for GlassMarble analysis


.SH SYNOPSIS
\fBgmb init [flags]\fP


.SH DESCRIPTION
Creates the .glassmarble workspace directory, state databases, and configuration files.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for init

.PP
\fB--json\fP[=false]
	Emit machine-readable JSON receipt


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	Color output mode: auto|always|never

.PP
\fB-c\fP, \fB--config\fP=""
	Config file path (default is $HOME/.glassmarble.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug logging

.PP
\fB--dir\fP=""
	Target repository directory for analysis and queries

.PP
\fB--max-json-mb\fP=0
	Refuse to load or commit an AKG state file (akg.json) larger than this many MiB (0 = unlimited)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-error output

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose output logging


.SH EXAMPLE
.EX
  # Initialize GlassMarble in current directory
  gmb init

  # Initialize a specific directory
  gmb init --dir ./backend

  # Initialize and emit JSON receipt
  gmb init --json
.EE


