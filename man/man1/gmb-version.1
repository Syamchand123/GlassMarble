.SH NAME
gmb-version - Print the version number of GlassMarble


.SH SYNOPSIS
\fBgmb version [flags]\fP


.SH DESCRIPTION
Display the GlassMarble CLI version, commit SHA, build timestamp, and build toolchain.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for version

.PP
\fB--json\fP[=false]
	Emit machine-readable JSON version metadata


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	Color output mode: auto|always|never

.PP
\fB-c\fP, \fB--config\fP=""
	Config file path (default is $HOME/.glassmarble.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug logging

.PP
\fB--dir\fP=""
	Target repository directory for analysis and queries

.PP
\fB--max-json-mb\fP=0
	Refuse to load or commit an AKG state file (akg.json) larger than this many MiB (0 = unlimited)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-error output

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose output logging


.SH EXAMPLE
.EX
  # Print branded version one-liner
  gmb version

  # Output version metadata as JSON
  gmb version --json
.EE


