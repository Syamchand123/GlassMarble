.TH "GMB" "1" "Aug 2026" "GlassMarble 0.1.0" "GlassMarble Manual"

.SH NAME
gmb-doctor - Run integrity diagnostics on the AKG state database


.SH SYNOPSIS
\fBgmb doctor [flags]\fP


.SH DESCRIPTION
Parses the active .glassmarble/akg.json database and verifies schema conformance,
parse-back integrity, duplicate node identifiers, and dangling edge references.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for doctor

.PP
\fB--json\fP[=false]
	Emit machine-readable JSON output


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	Color output mode: auto|always|never

.PP
\fB-c\fP, \fB--config\fP=""
	Config file path (default is $HOME/.glassmarble.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug logging

.PP
\fB--dir\fP=""
	Target repository directory for analysis and queries

.PP
\fB--max-json-mb\fP=0
	Refuse to load or commit an AKG state file (akg.json) larger than this many MiB (0 = unlimited)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-error output

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose output logging


.SH EXAMPLE
.EX
  # Run health and integrity checks
  gmb doctor

  # Output diagnostic results as JSON
  gmb doctor --json

  # Run diagnostics on a specific repository
  gmb doctor --dir ./backend
.EE


.SH SEE ALSO
\fBgmb(1)\fP


