.TH "GMB" "1" "Aug 2026" "GlassMarble 0.1.0" "GlassMarble Manual"

.SH NAME
gmb-patterns - Detect architectural patterns and smells from the committed AKG


.SH SYNOPSIS
\fBgmb patterns [flags]\fP


.SH DESCRIPTION
Runs Architecture Intelligence against the committed AKG:
component inference, pattern detection (e.g. Clean Architecture, Event-Driven, DDD Bounded Context)
and — with --smells — code & structural smell detection.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for patterns

.PP
\fB--json\fP[=false]
	Emit machine-readable JSON output

.PP
\fB--smells\fP[=false]
	Also run smell detection and include smells in the report


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	Color output mode: auto|always|never

.PP
\fB-c\fP, \fB--config\fP=""
	Config file path (default is $HOME/.glassmarble.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug logging

.PP
\fB--dir\fP=""
	Target repository directory for analysis and queries

.PP
\fB--max-json-mb\fP=0
	Refuse to load or commit an AKG state file (akg.json) larger than this many MiB (0 = unlimited)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-error output

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose output logging


.SH EXAMPLE
.EX
  # Run pattern detection on the active AKG
  gmb patterns

  # Include architectural smells in the output report
  gmb patterns --smells

  # Output detected patterns and smells as JSON
  gmb patterns --smells --json
.EE


.SH SEE ALSO
\fBgmb(1)\fP


