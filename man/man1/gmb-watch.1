.TH "GMB" "1" "Aug 2026" "GlassMarble 0.1.0" "GlassMarble Manual"

.SH NAME
gmb-watch - Continuously watch repository for source changes and update AKG


.SH SYNOPSIS
\fBgmb watch [flags]\fP


.SH DESCRIPTION
Watches the repository for file-system events (fsnotify) and triggers
incremental delta analysis whenever source files change. The git working-tree
fingerprint is re-checked before every rebuild so branch switches, rebases and
changes made outside the watcher's scope are also picked up.


.SH OPTIONS
\fB--abort-on-limit\fP[=false]
	Abort analysis if --max-nodes is exceeded (otherwise warn)

.PP
\fB--commit\fP=""
	Git commit hash to tag the analysis. Empty (default) diffs the working tree against HEAD (incremental delta)

.PP
\fB--dir\fP="."
	Target repository directory

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for watch

.PP
\fB--interval\fP=500ms
	Debounce interval for file-system events

.PP
\fB--link-level\fP="architecture"
	Linker detail level: architecture, standard, full

.PP
\fB--macro-inference\fP="all"
	Macro inference mode: disabled, structural, all

.PP
\fB--max-nodes\fP=0
	Max total CPG nodes before warning/abort (0 = unlimited)

.PP
\fB--verbose\fP[=false]
	Enable verbose output

.PP
\fB--workers\fP=0
	Number of parallel workers (default: CPUs)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	Color output mode: auto|always|never

.PP
\fB-c\fP, \fB--config\fP=""
	Config file path (default is $HOME/.glassmarble.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug logging

.PP
\fB--max-json-mb\fP=0
	Refuse to load or commit an AKG state file (akg.json) larger than this many MiB (0 = unlimited)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-error output


.SH EXAMPLE
.EX
  # Start file watcher on current repository
  gmb watch

  # Watch with a custom debounce interval
  gmb watch --interval 1s

  # Watch specific repository path
  gmb watch --dir ./backend
.EE


.SH SEE ALSO
\fBgmb(1)\fP


