.TH "GMB" "1" "Aug 2026" "GlassMarble 0.1.0" "GlassMarble Manual"

.SH NAME
gmb-import - Import a portable graph document, replacing the active AKG snapshot


.SH SYNOPSIS
\fBgmb import [graph.json] [flags]\fP


.SH DESCRIPTION
Replaces the active AKG database with the contents of a GraphJSON file
produced by 'gmb export' (or any compatible GraphJSON document). The
previous snapshot is overwritten by a single atomic akg.json write.

.PP
Dangling references in the imported document are rejected so the persisted
state always stays verified.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for import

.PP
\fB--json\fP[=false]
	Emit machine-readable JSON receipt


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	Color output mode: auto|always|never

.PP
\fB-c\fP, \fB--config\fP=""
	Config file path (default is $HOME/.glassmarble.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug logging

.PP
\fB--dir\fP=""
	Target repository directory for analysis and queries

.PP
\fB--max-json-mb\fP=0
	Refuse to load or commit an AKG state file (akg.json) larger than this many MiB (0 = unlimited)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-error output

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose output logging


.SH EXAMPLE
.EX
  # Import a GraphJSON snapshot into active repository
  gmb import graph.json

  # Import and emit JSON receipt
  gmb import graph.json --json
.EE


.SH SEE ALSO
\fBgmb(1)\fP


