.TH "GMB" "1" "Aug 2026" "GlassMarble 0.1.0" "GlassMarble Manual"

.SH NAME
gmb-housekeeping - Report and prune .glassmarble working-set storage (marbles, sessions, snapshots, memory)


.SH SYNOPSIS
\fBgmb housekeeping [flags]\fP


.SH DESCRIPTION
Scans .glassmarble/ and reports the bytes held by each working-set area
(marbles/, ai/, snapshots/, memory/, intelligence/), then optionally prunes saved diagrams,
chat sessions, and old snapshots.

.PP
The AKG state file (akg.json) is never pruned by this command.

.PP
Snapshots: use --prune-snapshots --keep N to retain only the N most recent snapshots
(default N=30, matching intelligence.snapshot_max_count). This reclaims the
bulk of snapshot storage (previously 1 GB+ for 29 full-graph snapshots).


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for housekeeping

.PP
\fB--json\fP[=false]
	Emit machine-readable JSON storage report

.PP
\fB--keep\fP=30
	Number of most recent snapshots to keep when pruning (default 30)

.PP
\fB--older-than\fP=30
	Retention window in days for pruned working-set files

.PP
\fB--prune\fP[=false]
	Delete marbles/sessions older than the retention window

.PP
\fB--prune-snapshots\fP[=false]
	Prune snapshots to keep only last N (see --keep)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	Color output mode: auto|always|never

.PP
\fB-c\fP, \fB--config\fP=""
	Config file path (default is $HOME/.glassmarble.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug logging

.PP
\fB--dir\fP=""
	Target repository directory for analysis and queries

.PP
\fB--max-json-mb\fP=0
	Refuse to load or commit an AKG state file (akg.json) larger than this many MiB (0 = unlimited)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-error output

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose output logging


.SH EXAMPLE
.EX
  # Report storage sizes of .glassmarble directory
  gmb housekeeping

  # Prune marbles and AI sessions older than 30 days
  gmb housekeeping --prune

  # Prune snapshots to keep last 10 only
  gmb housekeeping --prune-snapshots --keep 10

  # Prune both marbles/sessions and snapshots
  gmb housekeeping --prune --prune-snapshots --keep 10

  # Output storage usage as JSON
  gmb housekeeping --json
.EE


