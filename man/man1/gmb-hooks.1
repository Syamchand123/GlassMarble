.TH "GMB" "1" "Aug 2026" "GlassMarble 0.1.0" "GlassMarble Manual"

.SH NAME
gmb-hooks - Install or uninstall Git post-commit hooks for automatic AKG updates


.SH SYNOPSIS
\fBgmb hooks [install|uninstall] [flags]\fP


.SH DESCRIPTION
Installs a post-commit hook into .git/hooks/ to automatically run 'gmb analyze' after each commit.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for hooks


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	Color output mode: auto|always|never

.PP
\fB-c\fP, \fB--config\fP=""
	Config file path (default is $HOME/.glassmarble.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug logging

.PP
\fB--dir\fP=""
	Target repository directory for analysis and queries

.PP
\fB--max-json-mb\fP=0
	Refuse to load or commit an AKG state file (akg.json) larger than this many MiB (0 = unlimited)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-error output

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose output logging


.SH EXAMPLE
.EX
  # Install post-commit hook in active repository
  gmb hooks install

  # Uninstall post-commit hook
  gmb hooks uninstall
.EE


.SH SEE ALSO
\fBgmb(1)\fP


