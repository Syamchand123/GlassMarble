.TH "GMB" "1" "Aug 2026" "GlassMarble 0.1.0" "GlassMarble Manual"

.SH NAME
gmb-snapshot - Create and query point-in-time architecture snapshots


.SH SYNOPSIS
\fBgmb snapshot [flags]\fP


.SH DESCRIPTION
Snapshots capture the full architecture state (graph + Architecture Intelligence analysis)
at a commit or point in time.

.PP
Refs are resolved as stored commit prefixes first, then as git refs (tags,
branches, HEAD) via their author timestamp.


.SH OPTIONS
\fB--at\fP=""
	Show the state at a commit/ref (nearest snapshot at or before it)

.PP
\fB--create\fP[=false]
	Run architecture intelligence at HEAD and store a new snapshot

.PP
\fB--diagram\fP="dependency"
	Diagram type for --replay (e.g. dependency, class, layered, c4container)

.PP
\fB--diff\fP=""
	Architectural diff between two refs: --diff ' \&'

.PP
\fB--format\fP="mermaid"
	Diagram markup format for --replay: mermaid, plantuml or dot

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for snapshot

.PP
\fB--json\fP[=false]
	Emit machine-readable JSON output

.PP
\fB--list\fP[=false]
	List indexed snapshots

.PP
\fB--no-graph\fP[=false]
	Skip embedding the full graph (smaller files; disables --replay and structural diffs)

.PP
\fB--replay\fP=""
	Restore the embedded graph at a ref and render a diagram


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	Color output mode: auto|always|never

.PP
\fB-c\fP, \fB--config\fP=""
	Config file path (default is $HOME/.glassmarble.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug logging

.PP
\fB--dir\fP=""
	Target repository directory for analysis and queries

.PP
\fB--max-json-mb\fP=0
	Refuse to load or commit an AKG state file (akg.json) larger than this many MiB (0 = unlimited)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-error output

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose output logging


.SH EXAMPLE
.EX
  # Create a new snapshot from the committed graph at HEAD
  gmb snapshot --create

  # List all captured architecture snapshots
  gmb snapshot --list

  # List snapshots as JSON
  gmb snapshot --list --json

  # Inspect snapshot at a specific commit or tag
  gmb snapshot --at HEAD

  # Diff architecture between two snapshots or commits
  gmb snapshot --diff "main HEAD"

  # Replay and render a class diagram from a past snapshot
  gmb snapshot --replay v1.0.0 --diagram class
.EE


.SH SEE ALSO
\fBgmb(1)\fP


