.TH "GMB" "1" "Aug 2026" "GlassMarble 0.1.0" "GlassMarble Manual"

.SH NAME
gmb-compare - Diff two AKG snapshots and report the architectural changes


.SH SYNOPSIS
\fBgmb compare [base_graph.json] [head_graph.json] [flags]\fP


.SH DESCRIPTION
Compares two GraphJSON snapshots (e.g. main-branch export vs PR branch)
and prints the structural delta: added/removed nodes, added/removed edges, and
modified files. When run with no file arguments, diffs the committed AKG (git HEAD)
against the current working tree.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for compare

.PP
\fB--json\fP[=false]
	Emit machine-readable JSON output


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	Color output mode: auto|always|never

.PP
\fB-c\fP, \fB--config\fP=""
	Config file path (default is $HOME/.glassmarble.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug logging

.PP
\fB--dir\fP=""
	Target repository directory for analysis and queries

.PP
\fB--max-json-mb\fP=0
	Refuse to load or commit an AKG state file (akg.json) larger than this many MiB (0 = unlimited)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-error output

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose output logging


.SH EXAMPLE
.EX
  # Compare committed graph against uncommitted working tree
  gmb compare

  # Compare two exported graph JSON files
  gmb compare base.json head.json

  # Output architectural comparison as JSON
  gmb compare --json
.EE


.SH SEE ALSO
\fBgmb(1)\fP


